{
  "name": "constellate",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:web": "pnpm --filter @constellate/web dev",
    "dev:server": "pnpm --filter @constellate/server dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "e2e": "playwright test",
    "fixtures": "tsx scripts/build-fixtures.ts",
    "eval": "pnpm --filter @constellate/interpreter eval",
    "eval:replay": "pnpm --filter @constellate/interpreter eval:replay"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.54.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  }
}
