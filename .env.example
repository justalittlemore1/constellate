# Copy to .env at the repo root (never commit .env). Server-only values have no VITE_ prefix
# and must never be read by apps/web.

# ── server only ──
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# gemini-live | deepgram
STT_PROVIDER=gemini-live
# gemini | anthropic  (the eval harness decides by H4)
INTERPRETER_PROVIDER=gemini
# optional: only if the Deepgram adapter is used
DEEPGRAM_API_KEY=
PORT=8787
# comma-separated origins allowed to call the server; * in local dev
CORS_ORIGIN=*

# ── web (exposed to the browser; public values only) ──
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_SERVER_WS_URL=ws://localhost:8787/live
VITE_SERVER_HTTP_URL=http://localhost:8787
# 1 = run the web app against fixtures and recorded op streams, no server or Supabase needed
VITE_USE_MOCKS=1

# ── tests (CI secrets) ──
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
